{{--
  Hero slideshow — J3 COMPANY

  Slide dikelola dari admin panel (model `heroSlide`) — tambah/edit/hapus lewat
  /_admin, hanya slide berstatus PUBLISH yang tampil, urutan dari field `order`.
--}}
@let(slidesResult = await heroSlide.read({ filters: { status: { $eq: 'PUBLISH' } }, sort: 'order', order: 'asc', limit: 10, populate: ['image'] }))
@let(slides = slidesResult.data)

{{-- No slide published yet (fresh install, nothing added in /_admin) — keep the page's
     h1 present regardless of hero content state, matching the i===0 slide's own h1
     below when there IS at least one slide. --}}
@if(slides.length === 0)
  <h1 class="sr-only">J3 Company — Sepatu, Apparel & Aksesoris Import Premium</h1>
@end

<section
  role="region"
  aria-roledescription="carousel"
  aria-label="Featured collections"
  x-data="{
    current: 0,
    previous: null,
    count: {{ slides.length }},
    delay: 6500,
    timer: null,
    paused: false,
    reduce: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
    touchStartX: 0,
    touchStartY: 0,
    touchDeltaX: 0,
    swiping: false,
    start() {
      this.stop();
      if (this.reduce || this.count < 2) return;
      this.timer = setInterval(() => { if (!this.paused && !document.hidden) this.go(this.current + 1) }, this.delay);
    },
    stop() { if (this.timer) clearInterval(this.timer); this.timer = null },
    go(i) {
      const n = (i + this.count) % this.count;
      if (n === this.current) return;
      this.previous = this.current;
      this.current = n;
    },
    next() { this.go(this.current + 1); this.start() },
    prev() { this.go(this.current - 1); this.start() },
    onTouchStart(e) {
      if (this.count < 2) return;
      this.swiping = true;
      this.paused = true;
      this.touchStartX = e.touches[0].clientX;
      this.touchStartY = e.touches[0].clientY;
      this.touchDeltaX = 0;
    },
    onTouchMove(e) {
      if (!this.swiping) return;
      const dx = e.touches[0].clientX - this.touchStartX;
      const dy = e.touches[0].clientY - this.touchStartY;
      if (Math.abs(dx) > Math.abs(dy)) e.preventDefault();
      this.touchDeltaX = dx;
    },
    onTouchEnd() {
      if (!this.swiping) return;
      this.swiping = false;
      this.paused = false;
      if (Math.abs(this.touchDeltaX) > 50) {
        this.touchDeltaX < 0 ? this.next() : this.prev();
      }
      this.touchDeltaX = 0;
    }
  }"
  x-init="start()"
  @mouseenter="paused = true"
  @mouseleave="paused = false"
  @focusin="paused = true"
  @focusout="paused = false"
  @touchstart="onTouchStart($event)"
  @touchmove="onTouchMove($event)"
  @touchend="onTouchEnd()"
  @touchcancel="onTouchEnd()"
  class="relative h-[88svh] min-h-155 w-full touch-pan-y overflow-hidden bg-ink"
>
  @each((slide, i) in slides)
    <div
      role="group"
      aria-roledescription="slide"
      aria-label="{{ i + 1 }} of {{ slides.length }}"
      class="absolute inset-0 transition-opacity duration-[900ms] ease-out motion-reduce:transition-none"
      style="opacity: {{ i === 0 ? '1' : '0' }}; z-index: {{ i === 0 ? '20' : '0' }};"
      :style="current === {{ i }}
        ? 'opacity:1; z-index:20'
        : (previous === {{ i }} ? 'opacity:1; z-index:10' : 'opacity:0; z-index:0')"
      :aria-hidden="current === {{ i }} ? 'false' : 'true'"
      :inert="current === {{ i }} ? null : true"
    >
      <img
        src="{{ imgOptimize(slide.image.url, { w: 1920, q: 78 }) }}"
        srcset="{{ imgOptimize(slide.image.url, { w: 960, q: 74 }) }} 960w,
                {{ imgOptimize(slide.image.url, { w: 1440, q: 78 }) }} 1440w,
                {{ imgOptimize(slide.image.url, { w: 2400, q: 78 }) }} 2400w"
        sizes="100vw"
        alt="{{ slide.alt }}"
        class="size-full object-cover object-center"
        {{{ i === 0 ? 'fetchpriority="high"' : 'loading="lazy"' }}}
        decoding="async"
      />

      {{-- Scrim: berat di bawah agar caption tetap terbaca, plus wash atas untuk header transparan --}}
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/25 to-ink/45"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-ink/55 to-transparent"></div>

      {{-- Caption --}}
      <div class="absolute inset-0 flex items-end">
        <div class="mx-auto w-full max-w-350 px-5 pb-24 md:px-8 md:pb-28 lg:pb-32">
          <div class="max-w-2xl">
            <p class="font-display text-[11px] font-medium uppercase tracking-label text-brand">
              <span class="mr-3 inline-block h-px w-8 align-middle bg-brand" aria-hidden="true"></span>{{ slide.eyebrow }}
            </p>
            {{-- Only the first slide renders as <h1> — one per page for SEO; the rest use
                 a <p> with identical styling so multiple slides never produce multiple h1s. --}}
            @if(i === 0)
              <h1 class="mt-4 font-display text-4xl font-semibold uppercase leading-[0.95] tracking-tight text-white sm:text-6xl lg:text-7xl">
                {{ slide.title }}
              </h1>
            @else
              <p class="mt-4 font-display text-4xl font-semibold uppercase leading-[0.95] tracking-tight text-white sm:text-6xl lg:text-7xl">
                {{ slide.title }}
              </p>
            @end
            <p class="mt-5 max-w-lg text-sm leading-relaxed text-white/75 sm:text-base">
              {{ slide.subtitle }}
            </p>
            <a
              href="{{ slide.ctaHref }}"
              class="group mt-8 inline-flex items-center gap-3 bg-white px-7 py-3.5 font-display text-xs font-medium uppercase tracking-label text-ink transition-colors duration-300 hover:bg-brand hover:text-white"
            >
              {{ slide.ctaText }}
              <iconify-icon icon="lucide:arrow-right" class="size-3.5 text-[0.875rem] transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"></iconify-icon>
            </a>
          </div>
        </div>
      </div>
    </div>
  @end

  {{-- Panah + indikator: satu baris flex, panah nempel kiri, indikator didorong ke kanan via ml-auto --}}
  @if(slides.length > 1)
    <div class="absolute inset-x-5 bottom-8 z-30 flex items-center md:inset-x-8 lg:bottom-12">
      <div class="hidden items-center gap-3 md:flex">
        <button
          type="button"
          aria-label="Previous slide"
          @click="prev()"
          class="grid size-11 place-items-center rounded-full border border-white/25 text-white backdrop-blur-sm transition hover:border-white hover:bg-white hover:text-ink"
        >
          <iconify-icon icon="lucide:chevron-left" class="size-4 text-[1rem]" aria-hidden="true"></iconify-icon>
        </button>
        <button
          type="button"
          aria-label="Next slide"
          @click="next()"
          class="grid size-11 place-items-center rounded-full border border-white/25 text-white backdrop-blur-sm transition hover:border-white hover:bg-white hover:text-ink"
        >
          <iconify-icon icon="lucide:chevron-right" class="size-4 text-[1rem]" aria-hidden="true"></iconify-icon>
        </button>
      </div>

      {{-- Indikator: mx-auto di mobile (panah tersembunyi, jadi otomatis center),
           ml-auto dari md ke atas (didorong ke kanan, sejajar dengan panah di kiri) --}}
      <div class="mx-auto flex items-center gap-2.5 md:mx-0 md:ml-auto">
        @each((slide, i) in slides)
          <button
            type="button"
            aria-label="Go to slide {{ i + 1 }}"
            :aria-current="current === {{ i }} ? 'true' : 'false'"
            @click="go({{ i }}); start()"
            class="h-0.5 transition-all duration-500"
            :class="current === {{ i }} ? 'w-10 bg-brand' : 'w-5 bg-white/40 hover:bg-white/70'"
          ></button>
        @end
      </div>
    </div>
  @end

  <p class="sr-only" aria-live="polite" x-text="`Slide ${current + 1} of ${count}`"></p>
</section>
