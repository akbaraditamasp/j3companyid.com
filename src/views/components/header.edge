{{--
  Site header — J3 COMPANY

  Props:
    transparent : boolean (default false) — mode overlay di atas hero.
                  true  = fixed, transparan di scroll-top, solid putih setelah di-scroll
                  false = sticky, selalu solid putih (untuk halaman tanpa hero)
    path        : string (default '/') — path aktif untuk active-link.

  PENTING: `request` TIDAK tersedia di dalam komponen Edge (hanya di page/layout),
  jadi path wajib dikirim sebagai prop:
    @!component('components/header', { transparent: true, path: request.path })
--}}

@let(overlay = transparent === true)
@let(current = $props.get('path', '/'))
@let(navItems = [
  { label: 'Shop', href: '/shop' },
  { label: 'Brands', href: '/brands' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
])

<header
  x-data="{
    scrolled: false,
    alwaysSolid: {{ overlay ? 'false' : 'true' }},
    mobileOpen: false,
    get solid() { return this.alwaysSolid || this.scrolled || this.mobileOpen }
  }"
  x-init="scrolled = window.scrollY > 8"
  @scroll.window.passive="scrolled = window.scrollY > 8"
  @keydown.escape.window="mobileOpen = false"
  x-effect="document.body.classList.toggle('overflow-hidden', mobileOpen)"
  class="{{ overlay ? 'fixed' : 'sticky' }} inset-x-0 top-0 z-50 transition-[background-color,box-shadow,border-color] duration-300 ease-out"
  :class="solid
    ? 'bg-white/95 backdrop-blur-md border-b border-ink-100 shadow-[0_8px_24px_-16px_rgba(20,17,15,0.35)]'
    : 'bg-transparent border-b border-white/15'"
>
  <div class="mx-auto flex h-16 max-w-350 items-center justify-between px-5 md:h-20 md:px-8">

    {{-- Wordmark --}}
    <a href="/" class="flex items-center gap-2.5 translate-y-1">
      <img
        src="{{ imgOptimize(vite.static('logo.png'), { w: 120 }) }}"
        alt="J3 Company"
        class="h-6 w-auto -translate-y-1 md:h-7"
      />
      <span
        class="-translate-y-1.5 font-display text-lg font-semibold uppercase leading-none tracking-wordmark transition-colors duration-300 md:text-xl"
        :class="solid ? 'text-ink' : 'text-white'"
      >
        J3<span class="ml-1.5 font-light">Company</span>
      </span>
    </a>

    {{-- Nav desktop --}}
    <nav class="hidden items-center gap-9 lg:flex" aria-label="Primary">
      @each(item in navItems)
        @let(isActive = current === item.href || (item.href !== '/' && current.startsWith(item.href + '/')))
        <a
          href="{{ item.href }}"
          {{{ isActive ? 'aria-current="page"' : '' }}}
          class="group relative font-display text-[0.8125rem] font-medium uppercase tracking-label transition-colors duration-300"
          :class="solid ? 'text-ink-700 hover:text-ink' : 'text-white/85 hover:text-white'"
        >
          {{ item.label }}
          <span
            aria-hidden="true"
            class="absolute -bottom-1.5 left-0 h-px w-full origin-left bg-brand transition-transform duration-300 ease-out {{ isActive ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100' }}"
          ></span>
        </a>
      @end
    </nav>

    {{-- Aksi kanan --}}
    <div class="flex items-center gap-1 md:gap-2">
      <button
        type="button"
        aria-label="Search"
        class="grid size-10 place-items-center rounded-full transition-colors duration-300"
        :class="solid ? 'text-ink-700 hover:bg-ink-100' : 'text-white hover:bg-white/10'"
      >
        <iconify-icon icon="lucide:search" class="size-4.5 text-[1.125rem]" aria-hidden="true"></iconify-icon>
      </button>

      <a
        href="/wishlist"
        aria-label="Wishlist"
        class="relative grid size-10 place-items-center rounded-full transition-colors duration-300"
        :class="solid ? 'text-ink-700 hover:bg-ink-100' : 'text-white hover:bg-white/10'"
      >
        <iconify-icon icon="lucide:heart" class="size-4.5 text-[1.125rem]" aria-hidden="true"></iconify-icon>
        <span
          x-cloak
          x-show="$store.wishlist.count > 0"
          x-text="$store.wishlist.count"
          class="absolute -right-0.5 -top-0.5 grid size-4 place-items-center rounded-full bg-brand font-sans text-[9px] font-semibold text-white"
        ></span>
      </a>

      <a
        href="/cart"
        aria-label="Cart"
        class="relative grid size-10 place-items-center rounded-full transition-colors duration-300"
        :class="solid ? 'text-ink-700 hover:bg-ink-100' : 'text-white hover:bg-white/10'"
      >
        <iconify-icon icon="mdi:cart-outline" class="size-4.5 text-[1.125rem]" aria-hidden="true"></iconify-icon>
        <span
          x-cloak
          x-show="$store.cart.count > 0"
          x-text="$store.cart.count"
          class="absolute -right-0.5 -top-0.5 grid size-4 place-items-center rounded-full bg-brand font-sans text-[9px] font-semibold text-white"
        ></span>
      </a>

      {{-- Hamburger --}}
      <button
        type="button"
        aria-controls="mobile-menu"
        aria-label="Menu"
        :aria-expanded="mobileOpen"
        @click="mobileOpen = !mobileOpen"
        class="grid size-10 place-items-center rounded-full transition-colors duration-300 lg:hidden"
        :class="solid ? 'text-ink-700 hover:bg-ink-100' : 'text-white hover:bg-white/10'"
      >
        <iconify-icon :icon="mobileOpen ? 'lucide:x' : 'lucide:menu'" class="size-5 text-[1.25rem]" aria-hidden="true"></iconify-icon>
      </button>
    </div>
  </div>

  {{-- Panel mobile --}}
  <div x-cloak x-show="mobileOpen" class="lg:hidden">
    <div
      x-show="mobileOpen"
      x-transition.opacity.duration.250ms
      @click="mobileOpen = false"
      aria-hidden="true"
      class="fixed inset-x-0 bottom-0 top-16 z-40 bg-ink/40 backdrop-blur-sm md:top-20"
    ></div>

    <nav
      id="mobile-menu"
      aria-label="Mobile"
      x-show="mobileOpen"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 -translate-y-3"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-3"
      class="relative z-50 border-t border-ink-100 bg-white px-5 pb-8 pt-4"
    >
      @each((item, i) in navItems)
        @let(isActive = current === item.href || (item.href !== '/' && current.startsWith(item.href + '/')))
        <a
          href="{{ item.href }}"
          {{{ isActive ? 'aria-current="page"' : '' }}}
          class="flex items-center justify-between border-b border-ink-100 py-4 font-display text-2xl font-medium uppercase tracking-tight {{ isActive ? 'text-brand' : 'text-ink' }}"
        >
          {{ item.label }}
          <span class="font-sans text-xs tracking-label text-ink-300">0{{ i + 1 }}</span>
        </a>
      @end
    </nav>
  </div>
</header>
