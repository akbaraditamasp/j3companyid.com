{{--
  Product card — dipakai di grid Featured Products & (nanti) halaman /shop.
  Prop: product = { name, brand, price, compareAtPrice?, badge?, image, href }
  `image`: path relatif di /static, mis. 'products/red-wing-iron-ranger.jpg'.
  Kosongkan ('') untuk placeholder — lihat pola yang sama di hero-slideshow.edge.
--}}
<a href="{{ product.href }}" class="group block">
  <div class="relative aspect-4/5 overflow-hidden bg-ink-100">
    @if(product.badge)
      <span class="absolute left-3 top-3 z-10 bg-brand px-2.5 py-1 font-display text-[10px] font-medium uppercase tracking-label text-white">
        {{ product.badge }}
      </span>
    @end

    <button
      type="button"
      aria-label="Add to wishlist"
      class="absolute right-3 top-3 z-10 grid size-9 place-items-center rounded-full bg-white/90 text-ink-700 opacity-0 transition-opacity duration-300 hover:text-brand group-hover:opacity-100"
    >
      <iconify-icon icon="lucide:heart" class="size-4" aria-hidden="true"></iconify-icon>
    </button>

    @if(product.image)
      <img
        src="{{ imgOptimize(vite.static(product.image), { w: 640, q: 78 }) }}"
        srcset="{{ imgOptimize(vite.static(product.image), { w: 480, q: 74 }) }} 480w,
                {{ imgOptimize(vite.static(product.image), { w: 800, q: 78 }) }} 800w"
        sizes="(min-width: 768px) 25vw, 50vw"
        alt="{{ product.brand }} {{ product.name }}"
        class="size-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    @else
      <div class="grid size-full place-items-center p-4 text-center">
        <span class="font-display text-[10px] uppercase tracking-label text-ink-300">
          placeholder — taruh static/products/…
        </span>
      </div>
    @end

    {{-- Quick add: slide naik saat hover --}}
    <div class="absolute inset-x-0 bottom-0 translate-y-full bg-white/95 px-4 py-3 backdrop-blur-sm transition-transform duration-300 group-hover:translate-y-0">
      <span class="flex items-center justify-center gap-2 font-display text-xs font-medium uppercase tracking-label text-ink">
        <iconify-icon icon="mdi:cart-outline" class="size-3.5" aria-hidden="true"></iconify-icon>
        Quick Add
      </span>
    </div>
  </div>

  <div class="mt-4">
    <p class="font-display text-[11px] uppercase tracking-label text-ink-500">{{ product.brand }}</p>
    <h3 class="mt-1 font-display text-sm font-medium uppercase tracking-tight text-ink">{{ product.name }}</h3>
    <p class="mt-2 flex items-center gap-2">
      <span class="font-sans text-sm font-semibold text-ink">Rp {{ product.price.toLocaleString('id-ID') }}</span>
      @if(product.compareAtPrice)
        <span class="font-sans text-xs text-ink-300 line-through">Rp {{ product.compareAtPrice.toLocaleString('id-ID') }}</span>
      @end
    </p>
  </div>
</a>
