{{--
  Product card — dipakai di grid Featured Products & related products.
  Prop: product = record mentah dari product.read()/product.show() (relasi brand &
  thumbnail sudah ter-fetch). href/id dihitung di sini dari product.slug — caller
  tidak perlu remapping bentuk objek.
--}}
@let(pid = '/shop/' + product.slug)
@let(imgUrl = product.thumbnail?.url)
@let(cartImage = imgUrl ? imgOptimize(imgUrl, { w: 300, q: 75 }) : '')
@let(catalogItem = { id: pid, name: product.name, brand: product.brand?.name, price: product.price, image: cartImage, href: pid })

<a href="{{ pid }}" x-data="{}" class="group block">
  <div class="relative aspect-4/5 overflow-hidden bg-ink-100">
    @if(product.badge)
      <span class="absolute left-3 top-3 z-10 bg-brand px-2.5 py-1 font-display text-[10px] font-medium uppercase tracking-label text-white">
        {{ product.badge }}
      </span>
    @end

    <button
      type="button"
      aria-label="Add to wishlist"
      @click.prevent.stop="$store.wishlist.toggle({{ JSON.stringify(catalogItem) }})"
      class="absolute right-3 top-3 z-10 grid size-9 place-items-center rounded-full bg-white/90 transition-opacity duration-300"
      :class="$store.wishlist.has('{{ pid }}') ? 'opacity-100 text-brand' : 'opacity-0 text-ink-700 hover:text-brand group-hover:opacity-100'"
    >
      <iconify-icon :icon="$store.wishlist.has('{{ pid }}') ? 'mdi:heart' : 'lucide:heart'" class="size-4 text-[1rem]" aria-hidden="true"></iconify-icon>
    </button>

    @if(imgUrl)
      <img
        src="{{ imgOptimize(imgUrl, { w: 640, q: 78 }) }}"
        srcset="{{ imgOptimize(imgUrl, { w: 480, q: 74 }) }} 480w,
                {{ imgOptimize(imgUrl, { w: 800, q: 78 }) }} 800w"
        sizes="(min-width: 768px) 25vw, 50vw"
        alt="{{ product.brand?.name }} {{ product.name }}"
        class="size-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    @else
      <div class="grid size-full place-items-center p-4 text-center">
        <span class="font-display text-[10px] uppercase tracking-label text-ink-300">
          Belum ada foto
        </span>
      </div>
    @end

    {{-- Quick add: slide naik saat hover --}}
    <button
      type="button"
      @click.prevent.stop="$store.cart.add({{ JSON.stringify(catalogItem) }})"
      class="absolute inset-x-0 bottom-0 flex translate-y-full items-center justify-center gap-2 bg-white/95 px-4 py-3 font-display text-xs font-medium uppercase tracking-label text-ink backdrop-blur-sm transition-transform duration-300 group-hover:translate-y-0 hover:bg-ink hover:text-white"
    >
      <iconify-icon icon="mdi:cart-outline" class="size-3.5 text-[0.875rem]" aria-hidden="true"></iconify-icon>
      <span x-text="$store.cart.has('{{ pid }}') ? 'In Cart' : 'Quick Add'"></span>
    </button>
  </div>

  <div class="mt-4">
    <p class="font-display text-[11px] uppercase tracking-label text-ink-500">{{ product.brand?.name }}</p>
    <h3 class="mt-1 break-words font-display text-sm font-medium uppercase tracking-tight text-ink">{{ product.name }}</h3>
    <p class="mt-2 flex items-center gap-2">
      <span class="font-sans text-sm font-semibold text-ink">Rp {{ product.price.toLocaleString('id-ID') }}</span>
      @if(product.compareAtPrice)
        <span class="font-sans text-xs text-ink-300 line-through">Rp {{ product.compareAtPrice.toLocaleString('id-ID') }}</span>
      @end
    </p>
  </div>
</a>
