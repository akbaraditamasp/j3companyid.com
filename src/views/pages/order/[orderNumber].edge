{{--
  Order detail — status-aware landing page after checkout submit AND after Xendit
  redirect (success_redirect_url / failure_redirect_url in src/routes/checkout.ts
  both point here now). No auth — guest checkout, looked up by orderNumber only
  (in-process order.read(), bypasses the model's own bearer-gated REST endpoint,
  same pattern as product lookups on the shop detail page).
--}}
@component('layouts/main', { path: request.path })
  @slot('title')
    @let(titleResult = await order.read({ filters: { orderNumber: { $eq: params.orderNumber } }, limit: 1 }))
    @let(titleItem = titleResult.data[0])
    @if(!titleItem)
      Pesanan Tidak Ditemukan — J3 Company
    @else
      Pesanan {{ titleItem.orderNumber }} — J3 Company
    @end
  @end

  @slot('description')
    Detail dan status pembayaran pesanan Anda di J3 Company.
  @end

  {{-- Order pages contain a real customer's order number/status — no SEO value,
       and indexing them would leak that data into search results. --}}
  @slot('robots')
    noindex, nofollow
  @end

  @slot('main')
    @!component('components/header', { transparent: false, path: request.path })

    @let(result = await order.read({ filters: { orderNumber: { $eq: params.orderNumber } }, limit: 1 }))
    @let(item = result.data[0])
    @if(!item)
      {{ abort(404) }}
    @end

    @let(statusMeta = {
      PENDING: { label: 'Menunggu Pembayaran', class: 'border-amber-200 bg-amber-50 text-amber-700' },
      PAID: { label: 'Sudah Dibayar', class: 'border-green-200 bg-green-50 text-green-700' },
      EXPIRED: { label: 'Kedaluwarsa', class: 'border-ink-200 bg-ink-100 text-ink-500' },
      FAILED: { label: 'Gagal', class: 'border-red-200 bg-red-50 text-red-600' },
    })
    @let(badge = statusMeta[item.status])

    <div class="border-b border-ink-100">
      <div class="mx-auto flex max-w-350 items-center gap-2 px-5 py-4 font-display text-[11px] uppercase tracking-label text-ink-500 md:px-8">
        <a href="/" class="transition-colors hover:text-ink">Home</a>
        <iconify-icon icon="lucide:chevron-right" class="size-3 text-[0.75rem]" aria-hidden="true"></iconify-icon>
        <span class="text-ink">Pesanan {{ item.orderNumber }}</span>
      </div>
    </div>

    <section class="mx-auto max-w-350 px-5 py-10 md:px-8 md:py-16" x-data="{}">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="font-display text-3xl font-semibold uppercase tracking-tight text-ink md:text-4xl">
            Pesanan {{ item.orderNumber }}
          </h1>
          <p class="mt-2 text-sm text-ink-500">
            {{ new Date(item.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) }}
          </p>
        </div>
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center border px-3 py-1.5 font-display text-[11px] font-medium uppercase tracking-label {{ badge.class }}">
            {{ badge.label }}
          </span>
          <button
            type="button"
            @click="window.location.reload()"
            aria-label="Refresh status"
            class="grid size-9 place-items-center border border-ink-100 text-ink-700 transition-colors hover:border-ink hover:text-ink"
          >
            <iconify-icon icon="lucide:refresh-cw" class="size-3.5 text-[0.875rem]" aria-hidden="true"></iconify-icon>
          </button>
        </div>
      </div>

      @let(paymentUrl = item.paymentGateway === 'DOKU' ? item.dokuPaymentUrl : item.xenditInvoiceUrl)

      @if(item.status === 'PENDING')
        <div class="mt-8 border border-ink-100 bg-bone px-6 py-5">
          <p class="text-sm text-ink-700">Pesanan Anda telah dibuat. Selesaikan pembayaran untuk memproses pesanan.</p>
          <a
            href="{{ paymentUrl }}"
            class="mt-4 inline-flex items-center gap-2 bg-ink px-6 py-3 font-display text-xs font-medium uppercase tracking-label text-white transition-colors duration-300 hover:bg-brand"
          >
            Bayar Sekarang
            <iconify-icon icon="lucide:arrow-right" class="size-3.5 text-[0.875rem]" aria-hidden="true"></iconify-icon>
          </a>
        </div>
      @end

      <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-16">
        <div class="space-y-8 lg:col-span-2">
          <div>
            <h2 class="font-display text-xs font-medium uppercase tracking-label text-ink">Item Pesanan</h2>
            <div class="mt-4 divide-y divide-ink-100 border-t border-ink-100">
              @each(line in item.items)
                <div class="flex items-center justify-between gap-4 py-3 text-sm">
                  <div class="min-w-0">
                    <p class="truncate text-ink">{{ line.brand }} {{ line.name }}</p>
                    <p class="text-xs text-ink-500">Qty {{ line.qty }} × Rp {{ line.price.toLocaleString('id-ID') }}</p>
                  </div>
                  <span class="shrink-0 font-sans text-ink">Rp {{ line.subtotal.toLocaleString('id-ID') }}</span>
                </div>
              @end
            </div>
          </div>

          <div>
            <h2 class="font-display text-xs font-medium uppercase tracking-label text-ink">Informasi Pengiriman</h2>
            <dl class="mt-4 grid grid-cols-2 gap-y-4 border-t border-ink-100 pt-4 text-sm sm:grid-cols-3">
              <div class="col-span-2 sm:col-span-3">
                <dt class="font-display text-[10px] uppercase tracking-label text-ink-500">Tujuan</dt>
                <dd class="mt-1 text-ink">{{ item.shippingDestinationLabel }}</dd>
              </div>
              <div>
                <dt class="font-display text-[10px] uppercase tracking-label text-ink-500">Kurir</dt>
                <dd class="mt-1 text-ink">{{ item.shippingCourier }} — {{ item.shippingService }}</dd>
              </div>
              <div>
                <dt class="font-display text-[10px] uppercase tracking-label text-ink-500">Estimasi</dt>
                <dd class="mt-1 text-ink">{{ item.shippingEtd }}</dd>
              </div>
            </dl>
          </div>

          <div>
            <h2 class="font-display text-xs font-medium uppercase tracking-label text-ink">Informasi Penerima</h2>
            <dl class="mt-4 grid grid-cols-2 gap-y-4 border-t border-ink-100 pt-4 text-sm">
              <div>
                <dt class="font-display text-[10px] uppercase tracking-label text-ink-500">Nama</dt>
                <dd class="mt-1 text-ink">{{ item.customerName }}</dd>
              </div>
              <div>
                <dt class="font-display text-[10px] uppercase tracking-label text-ink-500">Telepon</dt>
                <dd class="mt-1 text-ink">{{ item.customerPhone }}</dd>
              </div>
              <div class="col-span-2">
                <dt class="font-display text-[10px] uppercase tracking-label text-ink-500">Email</dt>
                <dd class="mt-1 text-ink">{{ item.customerEmail }}</dd>
              </div>
              <div class="col-span-2">
                <dt class="font-display text-[10px] uppercase tracking-label text-ink-500">Alamat</dt>
                <dd class="mt-1 text-ink">{{ item.shippingAddress }}</dd>
              </div>
            </dl>
          </div>
        </div>

        <div class="h-fit border border-ink-100 p-6">
          <h2 class="font-display text-xs font-medium uppercase tracking-label text-ink">Ringkasan Pembayaran</h2>
          <div class="mt-5 space-y-2 border-t border-ink-100 pt-5 text-sm">
            <div class="flex items-center justify-between">
              <span class="text-ink-500">Subtotal</span>
              <span class="font-sans text-ink">Rp {{ item.subtotal.toLocaleString('id-ID') }}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-ink-500">Ongkos Kirim</span>
              <span class="font-sans text-ink">Rp {{ item.shippingCost.toLocaleString('id-ID') }}</span>
            </div>
          </div>
          <div class="mt-4 flex items-center justify-between border-t border-ink-100 pt-4">
            <span class="font-display text-xs uppercase tracking-label text-ink">Total</span>
            <span class="font-sans text-base font-semibold text-ink">Rp {{ item.total.toLocaleString('id-ID') }}</span>
          </div>
        </div>
      </div>

      <a href="/" class="mt-10 inline-flex items-center gap-2 font-display text-xs font-medium uppercase tracking-label text-ink-500 transition-colors hover:text-ink">
        <iconify-icon icon="lucide:arrow-left" class="size-3.5 text-[0.875rem]" aria-hidden="true"></iconify-icon>
        Kembali ke Beranda
      </a>
    </section>
  @end
@end
