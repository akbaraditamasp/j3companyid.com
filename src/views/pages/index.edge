@component('layouts/main', { path: request.path })
  @slot('title')
    J3 COMPANY — Sepatu, Apparel & Aksesoris Import Premium
  @end

  @slot('description')
    Red Wing, RM Williams, Filson, dan koleksi vintage langka lainnya — dikurasi langsung oleh J3 Company sejak 2019.
  @end

  @slot('main')
    {{-- `path` wajib dikirim manual — `request` tidak tersedia di dalam @component --}}
    @!component('components/header', { transparent: true, path: request.path })

    @!component('components/hero-slideshow')

    {{-- ---- Placeholder di bawah hero: hanya agar scroll behavior bisa diuji ---- --}}
    <section class="mx-auto max-w-350 px-5 py-20 md:px-8 md:py-28">
      <div class="flex items-end justify-between gap-8 border-b border-ink-100 pb-6">
        <h2 class="font-display text-3xl font-semibold uppercase tracking-tight text-ink md:text-4xl">
          Shop By Category
        </h2>
        <a href="/shop" class="hidden shrink-0 font-display text-xs uppercase tracking-label text-ink-500 transition-colors hover:text-brand sm:block">
          View all
        </a>
      </div>

      @let(categoriesResult = await category.read({ limit: 6, sort: 'createdAt', order: 'asc' }))
      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        @each(cat in categoriesResult.data)
          <a href="/shop/category/{{ cat.slug }}" class="group relative block aspect-4/5 overflow-hidden bg-ink-100">
            @if(cat.image?.url)
              <img
                src="{{ imgOptimize(cat.image.url, { w: 640, q: 78 }) }}"
                srcset="{{ imgOptimize(cat.image.url, { w: 480, q: 74 }) }} 480w,
                        {{ imgOptimize(cat.image.url, { w: 800, q: 78 }) }} 800w"
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                alt="{{ cat.name }}"
                class="absolute inset-0 size-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            @end
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent"></div>
            <div class="absolute inset-0 bg-ink/0 transition-colors duration-500 group-hover:bg-ink/25"></div>
            <div class="absolute inset-x-0 bottom-0 p-6">
              <p class="font-display text-2xl font-semibold uppercase tracking-tight text-white">{{ cat.name }}</p>
            </div>
          </a>
        @end
      </div>
    </section>

    @let(productsResult = await product.read({ filters: { status: { $eq: 'PUBLISH' } }, limit: 8, sort: 'createdAt', order: 'desc', populate: ['brand', 'thumbnail'] }))

    <section class="mx-auto max-w-350 px-5 py-20 md:px-8 md:py-28">
      <div class="flex items-end justify-between gap-8 border-b border-ink-100 pb-6">
        <h2 class="font-display text-3xl font-semibold uppercase tracking-tight text-ink md:text-4xl">
          Featured Products
        </h2>
        <a href="/shop" class="hidden shrink-0 font-display text-xs uppercase tracking-label text-ink-500 transition-colors hover:text-brand sm:block">
          View all
        </a>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-4">
        @each(item in productsResult.data)
          @!component('components/product-card', { product: item })
        @end
      </div>
    </section>

    @let(story = {
      image: 'brand/heritage.jpg',
    })
    @let(content = await siteContent.get())

    <section class="bg-ink">
      <div class="mx-auto grid max-w-350 grid-cols-1 lg:grid-cols-12">
        {{-- Foto / placeholder --}}
        <div class="relative aspect-4/3 overflow-hidden lg:aspect-auto lg:col-span-7">
          @if(story.image)
            <img
              src="{{ imgOptimize(vite.static(story.image), { w: 1600, q: 80 }) }}"
              srcset="{{ imgOptimize(vite.static(story.image), { w: 800, q: 76 }) }} 800w,
                      {{ imgOptimize(vite.static(story.image), { w: 1600, q: 80 }) }} 1600w"
              sizes="(min-width: 1024px) 58vw, 100vw"
              alt="Proses kurasi J3 Company"
              class="absolute inset-0 size-full object-cover object-center"
              loading="lazy"
              decoding="async"
            />
          @else
            <div class="absolute inset-0 bg-[radial-gradient(120%_120%_at_30%_10%,#4a3b31_0%,#241c17_55%,#14110f_100%)]"></div>
            <div class="pointer-events-none absolute inset-0 grid place-items-center p-6 text-center">
              <span class="font-display text-[10px] uppercase tracking-label text-white/25">
                placeholder — taruh static/brand/heritage.jpg
              </span>
            </div>
          @end
        </div>

        {{-- Narasi --}}
        <div class="flex flex-col justify-center px-5 py-16 md:px-8 md:py-24 lg:col-span-5 lg:px-14">
          <p class="font-display text-[11px] font-medium uppercase tracking-label text-brand">
            <span class="mr-3 inline-block h-px w-8 align-middle bg-brand" aria-hidden="true"></span>The J3 Standard
          </p>
          <h2 class="mt-4 font-display text-3xl font-semibold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">
            Curated, Not Just Collected
          </h2>
          <p class="mt-6 text-sm leading-relaxed text-white/70">
            Setiap produk yang masuk katalog J3 Company — sepatu, apparel, hingga aksesoris — melalui seleksi ketat dari tim yang memahami detail konstruksi, riwayat produksi, dan karakter material setiap barang. Kami tidak mengejar kuantitas — kami mengejar produk yang layak menyandang nama besarnya.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-white/70">
            Red Wing, RM Williams, Filson, dan koleksi vintage langka lainnya kami dapatkan dari jaringan sumber pilihan, lalu dikurasi langsung oleh tim yang sama sejak J3 Company pertama kali berdiri.
          </p>

          <div class="mt-10 grid grid-cols-3 gap-6 border-t border-white/10 pt-8">
            @each(stat in content.stats)
              <div>
                <p class="font-display text-2xl font-semibold text-white sm:text-3xl">{{ stat.value }}</p>
                <p class="mt-1 text-[11px] uppercase tracking-label text-white/40">{{ stat.label }}</p>
              </div>
            @end
          </div>

          <a
            href="/about"
            class="group mt-10 inline-flex w-fit items-center gap-3 font-display text-xs font-medium uppercase tracking-label text-white transition-colors duration-300 hover:text-brand"
          >
            Pelajari Proses Kami
            <iconify-icon icon="lucide:arrow-right" class="size-3.5 text-[0.875rem] transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"></iconify-icon>
          </a>
        </div>
      </div>
    </section>

    @let(testimonialsResult = await testimonial.read({ filters: { status: { $eq: 'PUBLISH' } }, limit: 3, sort: 'createdAt', order: 'desc' }))
    @let(testimonials = testimonialsResult.data)

    <section class="mx-auto max-w-350 px-5 py-20 md:px-8 md:py-28">
      <div class="mx-auto max-w-xl text-center">
        <p class="font-display text-[11px] font-medium uppercase tracking-label text-brand">Customer Stories</p>
        <h2 class="mt-4 font-display text-3xl font-semibold uppercase tracking-tight text-ink md:text-4xl">
          Dipercaya Kolektor Fashion Premium
        </h2>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-3">
        @each(item in testimonials)
          <div class="flex h-full flex-col border border-ink-100 p-8">
            <div class="flex items-center gap-1 text-brand">
              @each(i in Array.from({ length: item.rating }))
                <iconify-icon icon="mdi:star" class="size-4 text-[1rem]" aria-hidden="true"></iconify-icon>
              @end
            </div>

            <div class="mt-5 flex-1">
              <p class="text-sm leading-relaxed text-ink-700">"{{ item.quote }}"</p>
            </div>

            <div class="mt-6 flex items-center gap-3 border-t border-ink-100 pt-6">
              <div class="grid size-10 shrink-0 place-items-center rounded-full bg-ink-100 font-display text-xs font-semibold uppercase text-ink-500">
                {{ item.name.charAt(0) }}
              </div>
              <div>
                <p class="font-display text-xs font-semibold uppercase tracking-tight text-ink">{{ item.name }}</p>
                <p class="text-xs text-ink-500">{{ item.location }} · {{ item.product }}</p>
              </div>
            </div>
          </div>
        @end
      </div>
    </section>

    @let(brandsResult = await brand.read({ filters: { featuredOnHomepage: { $eq: true } }, sort: 'name', order: 'asc', limit: 10 }))

    <section class="border-y border-ink-100 bg-bone py-14">
      <p class="text-center font-display text-[11px] uppercase tracking-label text-ink-500">Brands we carry</p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-x-12 gap-y-5 px-5">
        @each((b, i) in brandsResult.data)
          <a href="/brands/{{ b.slug }}" class="{{ i >= 6 ? 'hidden md:inline-block' : '' }} font-display text-lg font-medium uppercase tracking-wordmark text-ink-300 transition-colors hover:text-ink md:text-xl">{{ b.name }}</a>
        @end
      </div>
    </section>
  @end
@end
