{{--
  Halaman Contact — route /contact. Form submit ke POST /api/contact (custom route
  publik, src/routes/contact.ts) yang menyimpan ke model contactMessage secara
  in-process — TIDAK lewat /api/contactMessage bawaan (itu butuh Authorization:
  Bearer <token>, hanya untuk admin panel). Pesan yang masuk bisa dicek/ditandai
  selesai dari /_admin.
--}}
@component('layouts/main')
  @slot('title')
    Contact — J3 Company
  @end

  @slot('description')
    Hubungi tim J3 Company untuk pertanyaan produk, pesanan, atau kerja sama.
  @end

  @slot('main')
    @!component('components/header', { transparent: false, path: request.path })

    {{-- Breadcrumb --}}
    <div class="border-b border-ink-100">
      <div class="mx-auto flex max-w-350 items-center gap-2 px-5 py-4 font-display text-[11px] uppercase tracking-label text-ink-500 md:px-8">
        <a href="/" class="transition-colors hover:text-ink">Home</a>
        <iconify-icon icon="lucide:chevron-right" class="size-3 text-[0.75rem]" aria-hidden="true"></iconify-icon>
        <span class="text-ink">Contact</span>
      </div>
    </div>

    <section class="mx-auto max-w-350 px-5 py-10 md:px-8 md:py-16">
      <h1 class="font-display text-3xl font-semibold uppercase tracking-tight text-ink md:text-4xl">
        Hubungi Kami
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-700">
        Ada pertanyaan soal produk, status pesanan, atau ingin kerja sama? Isi form di bawah atau langsung hubungi kami lewat WhatsApp — tim kami akan merespons secepatnya.
      </p>

      <div
        class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-16"
        x-data="{
          loading: false,
          error: '',
          success: false,
          form: { name: '', email: '', phone: '', message: '' },
          async submit() {
            this.error = '';
            this.loading = true;
            try {
              const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(this.form),
              });
              const data = await res.json();
              if (!res.ok) {
                this.error = data.message || 'Pesan gagal terkirim, silakan periksa kembali isian Anda.';
                this.loading = false;
                return;
              }
              this.success = true;
              this.form = { name: '', email: '', phone: '', message: '' };
            } catch (e) {
              this.error = 'Terjadi kesalahan jaringan, silakan coba lagi.';
            } finally {
              this.loading = false;
            }
          },
        }"
      >
        {{-- Form --}}
        <div class="lg:col-span-2">
          <div x-show="success" x-cloak class="flex flex-col items-center gap-4 border border-ink-100 px-6 py-16 text-center">
            <iconify-icon icon="lucide:check-circle" class="size-10 text-[2.5rem] text-brand" aria-hidden="true"></iconify-icon>
            <h2 class="font-display text-sm font-semibold uppercase tracking-label text-ink">Pesan Terkirim</h2>
            <p class="max-w-sm text-sm text-ink-500">Terima kasih sudah menghubungi J3 Company. Tim kami akan segera merespons ke email Anda.</p>
            <button
              type="button"
              @click="success = false"
              class="mt-2 font-display text-xs font-medium uppercase tracking-label text-ink-500 transition-colors hover:text-brand"
            >
              Kirim pesan lain
            </button>
          </div>

          <form x-show="!success" @submit.prevent="submit()" class="space-y-6">
            <div>
              <label class="font-display text-[11px] uppercase tracking-label text-ink-500" for="name">Nama Lengkap</label>
              <input
                id="name"
                x-model="form.name"
                required
                type="text"
                class="mt-2 w-full border border-ink-100 px-4 py-3 text-sm text-ink focus:border-ink focus:outline-none"
              />
            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label class="font-display text-[11px] uppercase tracking-label text-ink-500" for="email">Email</label>
                <input
                  id="email"
                  x-model="form.email"
                  required
                  type="email"
                  class="mt-2 w-full border border-ink-100 px-4 py-3 text-sm text-ink focus:border-ink focus:outline-none"
                />
              </div>
              <div>
                <label class="font-display text-[11px] uppercase tracking-label text-ink-500" for="phone">No. Telepon (opsional)</label>
                <input
                  id="phone"
                  x-model="form.phone"
                  type="tel"
                  class="mt-2 w-full border border-ink-100 px-4 py-3 text-sm text-ink focus:border-ink focus:outline-none"
                />
              </div>
            </div>

            <div>
              <label class="font-display text-[11px] uppercase tracking-label text-ink-500" for="message">Pesan</label>
              <textarea
                id="message"
                x-model="form.message"
                required
                rows="6"
                minlength="10"
                placeholder="Ceritakan apa yang bisa kami bantu..."
                class="mt-2 w-full border border-ink-100 px-4 py-3 text-sm text-ink focus:border-ink focus:outline-none"
              ></textarea>
            </div>

            <div x-show="error" x-text="error" class="border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600"></div>

            <button
              type="submit"
              :disabled="loading"
              class="flex w-full items-center justify-center gap-2 bg-ink px-6 py-3.5 font-display text-xs font-medium uppercase tracking-label text-white transition-colors duration-300 hover:bg-brand disabled:cursor-not-allowed disabled:opacity-60 sm:w-fit"
            >
              <span x-show="!loading">Kirim Pesan</span>
              <span x-show="loading">Mengirim...</span>
            </button>
          </form>
        </div>

        {{-- Info kontak --}}
        <div class="space-y-6">
          <div class="border border-ink-100 p-6">
            <div class="flex items-start gap-3">
              <iconify-icon icon="lucide:map-pin" class="size-5 text-[1.25rem] shrink-0 text-brand" aria-hidden="true"></iconify-icon>
              <div>
                <h3 class="font-display text-[11px] font-semibold uppercase tracking-label text-ink">Alamat</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-700">Jl. Sudirman No. 123<br />Jakarta Pusat, 10220</p>
              </div>
            </div>
          </div>

          <div class="border border-ink-100 p-6">
            <div class="flex items-start gap-3">
              <iconify-icon icon="lucide:clock" class="size-5 text-[1.25rem] shrink-0 text-brand" aria-hidden="true"></iconify-icon>
              <div>
                <h3 class="font-display text-[11px] font-semibold uppercase tracking-label text-ink">Jam Operasional</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-700">Senin – Jumat, 09.00 – 17.00 WIB</p>
              </div>
            </div>
          </div>

          <div class="border border-ink-100 p-6">
            <div class="flex items-start gap-3">
              <iconify-icon icon="lucide:mail" class="size-5 text-[1.25rem] shrink-0 text-brand" aria-hidden="true"></iconify-icon>
              <div>
                <h3 class="font-display text-[11px] font-semibold uppercase tracking-label text-ink">Email</h3>
                <a href="mailto:cs@j3companyid.com" class="mt-1 block text-sm text-ink-700 transition-colors hover:text-brand">cs@j3companyid.com</a>
              </div>
            </div>
          </div>

          <a
            href="https://wa.me/6281234567890"
            class="flex items-center justify-center gap-2 bg-ink px-6 py-3.5 font-display text-xs font-medium uppercase tracking-label text-white transition-colors duration-300 hover:bg-brand"
          >
            <iconify-icon icon="simple-icons:whatsapp" class="size-4 text-[1rem]" aria-hidden="true"></iconify-icon>
            Chat via WhatsApp
          </a>
        </div>
      </div>
    </section>
  @end
@end
