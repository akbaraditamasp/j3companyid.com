{{--
  Halaman About — route /about. Sebagian besar copy statis di template, kecuali
  `stats` dan `trustBadges` yang ditarik dari vars `siteContent` (src/vars/site-content.ts)
  supaya tidak drift dari angka yang sama di homepage.
--}}
@component('layouts/main', { path: request.path })
  @slot('title')
    Tentang Kami — J3 Company
  @end

  @slot('description')
    J3 Company mengurasi langsung sepatu, apparel, dan aksesoris import premium sejak 2019 — bukan sekadar re-seller.
  @end

  @slot('main')
    @!component('components/header', { transparent: false, path: request.path })

    {{-- Breadcrumb --}}
    <div class="border-b border-ink-100">
      <div class="mx-auto flex max-w-350 items-center gap-2 px-5 py-4 font-display text-[11px] uppercase tracking-label text-ink-500 md:px-8">
        <a href="/" class="transition-colors hover:text-ink">Home</a>
        <iconify-icon icon="lucide:chevron-right" class="size-3 text-[0.75rem]" aria-hidden="true"></iconify-icon>
        <span class="text-ink">About</span>
      </div>
    </div>

    {{-- Hero intro --}}
    <section class="mx-auto max-w-350 px-5 py-20 md:px-8 md:py-28">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-display text-[11px] font-medium uppercase tracking-label text-brand">Tentang Kami</p>
        <h1 class="mt-4 font-display text-4xl font-semibold uppercase leading-[0.95] tracking-tight text-ink sm:text-5xl lg:text-6xl">
          Bukan Re-Seller.<br />Kurator.
        </h1>
        <p class="mt-6 text-base leading-relaxed text-ink-700">
          J3 Company mendatangkan sepatu, apparel, dan aksesoris import premium — Red Wing, RM Williams, Filson, hingga koleksi vintage langka — lewat proses kurasi langsung sejak 2019, bukan sekadar jual-beli barang titipan.
        </p>
      </div>
    </section>

    {{-- Brand story --}}
    @let(story = { image: 'brand/heritage.jpg' })
    @let(content = await siteContent.get())

    <section class="bg-ink">
      <div class="mx-auto grid max-w-350 grid-cols-1 lg:grid-cols-12">
        <div class="relative aspect-4/3 overflow-hidden lg:aspect-auto lg:col-span-7">
          @if(story.image)
            <img
              src="{{ imgOptimize(vite.static(story.image), { w: 1600, q: 80 }) }}"
              srcset="{{ imgOptimize(vite.static(story.image), { w: 800, q: 76 }) }} 800w,
                      {{ imgOptimize(vite.static(story.image), { w: 1600, q: 80 }) }} 1600w"
              sizes="(min-width: 1024px) 58vw, 100vw"
              alt="Proses kurasi J3 Company"
              class="absolute inset-0 size-full object-cover object-center"
              loading="lazy"
              decoding="async"
            />
          @else
            <div class="absolute inset-0 bg-[radial-gradient(120%_120%_at_30%_10%,#4a3b31_0%,#241c17_55%,#14110f_100%)]"></div>
          @end
        </div>

        <div class="flex flex-col justify-center px-5 py-16 md:px-8 md:py-24 lg:col-span-5 lg:px-14">
          <p class="font-display text-[11px] font-medium uppercase tracking-label text-brand">
            <span class="mr-3 inline-block h-px w-8 align-middle bg-brand" aria-hidden="true"></span>The J3 Standard
          </p>
          <h2 class="mt-4 font-display text-3xl font-semibold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl">
            Kami Tidak Menjual Apa yang Mudah Didapat
          </h2>
          <p class="mt-6 text-sm leading-relaxed text-white/70">
            Kebanyakan toko import cukup menunggu stok datang, lalu memajangnya. J3 Company bekerja sebaliknya — tim kami turun langsung ke sumber, memeriksa detail konstruksi, riwayat produksi, dan karakter material setiap barang sebelum satu unit pun masuk katalog.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-white/70">
            Prosesnya lebih lambat. Tapi itu sebabnya setiap Red Wing, RM Williams, atau Filson yang sampai ke tangan Anda bukan sekadar "barang import" — melainkan pilihan yang sudah melalui pertimbangan yang sama seriusnya dengan yang akan Anda lakukan sebelum membelinya.
          </p>

          <div class="mt-10 grid grid-cols-3 gap-6 border-t border-white/10 pt-8">
            @each(stat in content.stats)
              <div>
                <p class="font-display text-2xl font-semibold text-white sm:text-3xl">{{ stat.value }}</p>
                <p class="mt-1 text-[11px] uppercase tracking-label text-white/40">{{ stat.label }}</p>
              </div>
            @end
          </div>
        </div>
      </div>
    </section>

    {{-- Value pillars --}}
    <section class="mx-auto max-w-350 px-5 py-20 md:px-8 md:py-28">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-semibold uppercase tracking-tight text-ink md:text-4xl">
          Kenapa J3 Company
        </h2>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-3">
        @each(pillar in [
          { icon: 'lucide:search-check', title: 'Kurasi Ketat', desc: 'Setiap produk melewati seleksi manual tim J3 — bukan auto-listing dari supplier. Yang tidak lolos standar, tidak akan pernah masuk katalog.' },
          { icon: 'lucide:shield-check', title: 'Keaslian Terjamin', desc: 'Sumber langsung dari jaringan terpercaya, bukan reseller berlapis. Setiap unit yang sampai ke Anda adalah barang asli, bukan replika atau grade kedua.' },
          { icon: 'lucide:globe', title: 'Sourcing Langsung', desc: 'Kami memutus rantai perantara — dari sumber di 3 negara, langsung ke gudang J3 Company, tanpa markup berlapis yang biasa terjadi di jalur import konvensional.' },
        ])
          <div class="flex h-full flex-col border border-ink-100 p-8">
            <iconify-icon icon="{{ pillar.icon }}" class="size-7 text-[1.75rem] text-brand" aria-hidden="true"></iconify-icon>
            <h3 class="mt-5 font-display text-sm font-semibold uppercase tracking-label text-ink">{{ pillar.title }}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-700">{{ pillar.desc }}</p>
          </div>
        @end
      </div>
    </section>

    {{-- Trust badges --}}
    <section class="border-y border-ink-100 bg-bone py-14">
      <div class="mx-auto grid max-w-350 grid-cols-3 gap-4 px-5 md:px-8">
        @each(trust in content.trustBadges)
          <div class="flex flex-col items-center gap-2 text-center">
            <iconify-icon icon="{{ trust.icon }}" class="size-6 text-[1.5rem] text-ink-500" aria-hidden="true"></iconify-icon>
            <span class="font-display text-[10px] uppercase tracking-label text-ink-500">{{ trust.label }}</span>
          </div>
        @end
      </div>
    </section>

    {{-- Closing CTA --}}
    <section class="mx-auto max-w-350 px-5 py-20 md:px-8 md:py-28">
      <div class="mx-auto flex max-w-2xl flex-col items-center gap-6 text-center">
        <h2 class="font-display text-3xl font-semibold uppercase tracking-tight text-ink md:text-4xl">
          Lihat Sendiri Hasilnya
        </h2>
        <p class="text-sm text-ink-500">Ratusan produk terkurasi, siap dijelajahi.</p>
        <a
          href="/shop"
          class="group inline-flex items-center gap-2 bg-ink px-8 py-3.5 font-display text-xs font-medium uppercase tracking-label text-white transition-colors duration-300 hover:bg-brand"
        >
          Jelajahi Koleksi
          <iconify-icon icon="lucide:arrow-right" class="size-3.5 text-[0.875rem] transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"></iconify-icon>
        </a>
      </div>
    </section>
  @end
@end
