# Server
PORT=3000

# Database
DB_PATH=rocksdb://data
DB_NAMESPACE=general
DB_DATABASE=general

# File storage — S3-compatible bucket (config.ts wires up the S3 adapter)
S3_BUCKET=my-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_URL=

# Image optimization — comma-separated external hosts allowed for GET /img besides same-origin/localhost
IMG_HOSTS=

# SEO — public origin used for canonical/Open Graph URLs and sitemap.xml (no trailing
# slash). Bun's own request.url reports the internal scheme/host, which is wrong behind
# a TLS-terminating reverse proxy — set this to the real public URL in production.
SITE_URL=https://j3companyid.com

# Xendit (checkout) — secret key from the Xendit dashboard (test/sandbox key while developing),
# and the callback verification token set under Settings > Callbacks for the webhook endpoint
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# RajaOngkir (Komerce) — shipping cost calculation. Free "Starter" tier: 100 req/day.
# Get a key at https://rajaongkir.com, then set `shipping` vars' originAreaId via
# the admin panel (look it up with GET /api/shipping/destinations?search=<your city>).
RAJAONGKIR_API_KEY=

# Stalwart mail server — sync akun mail (src/services/stalwart.ts, POST /api/stalwart/sync)
STALWART_URL=http://localhost:8081
STALWART_API_KEY=
# Domain yang di-hardcode untuk semua akun mail — user tidak input domain sendiri
STALWART_DOMAIN=j3companyid.com
